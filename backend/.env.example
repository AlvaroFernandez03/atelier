# Copia este archivo como ".env" y cambia JWT_SECRET por una frase tuya.
PORT=3000
JWT_SECRET=cambia_esto_por_una_frase_secreta_larga_y_unica

# El usuario que se registre con este email será administrador de la tienda
ADMIN_EMAIL=admin@tienda.com

# Emails de la tienda (opcional). Clave gratuita en https://resend.com
# Si la dejas vacía, la tienda funciona igual pero sin enviar correos.
RESEND_API_KEY=

# URL donde corre la tienda (para los enlaces dentro de los emails)
FRONTEND_URL=http://localhost:3000

# Solo para la demo pública del portfolio (Render): cinta con las cuentas de
# prueba y cambios de contraseña bloqueados. En tu ordenador, déjalo sin poner.
# DEMO=1
